{
  "permissions": {
    "allow": [
      "Bash(npx eslint *)",
      "Bash(npm run *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-and-lint.sh\""
          }
        ]
      }
    ]
  }
}
